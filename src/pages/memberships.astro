---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PlanCards from '../components/PlanCards.astro';
import RateToggle from '../components/RateToggle.astro';
import Icon from '../components/Icon.astro';
import NewToGymCta from '../components/NewToGymCta.astro';
import MembershipCalculator from '../islands/MembershipCalculator';
import PlanFinder from '../islands/PlanFinder';
import { site } from '../config/site';
import { activationFee, calculatorPeriods, peso, plans, promos, ratesDisclaimer, sessions } from '../data/rates';
import { faq } from '../data/faq';
import { faqSchema } from '../lib/schema';

const crumbs = [{ name: 'Memberships', path: '/memberships/' }];
const rateFaq = faq.filter((f) => f.category === 'Rates' && f.confirmed);
const calcPlans = plans.map(({ id, name, price }) => ({ id, name, price }));
const finderPrices = { basic: plans[0].price, premium: plans[1].price };
---

<BaseLayout
  title="Gym Membership Rates CDO | Student Rates from ₱1,200 | ActiveZone"
  description="ActiveZone CDO gym membership rates: Basic ₱1,740 and Premium ₱2,340 per 4 weeks. Student rates ₱1,200 and ₱1,650. Walk-in ₱200/day. Divisoria, Cagayan de Oro."
  ogImage="memberships"
  breadcrumbs={crumbs}
  schema={[faqSchema(rateFaq)]}
>
  <PageHero
    eyebrow="Memberships & rates"
    title="Gym membership rates in CDO"
    lede="Two simple plans, lower student rates and pay-per-visit options. No guesswork: every price is right here."
    photo="gym-weights"
    crumbs={crumbs}
  >
    <div class="mt-7 flex flex-wrap gap-2 text-sm font-semibold">
      <a href="#plans" class="rounded-full bg-white/10 px-4 py-2 hover:bg-white/15">Plans</a>
      <a href="#sessions" class="rounded-full bg-white/10 px-4 py-2 hover:bg-white/15">Walk-in & classes</a>
      <a href="#calculator" class="rounded-full bg-white/10 px-4 py-2 hover:bg-white/15">Calculator</a>
      <a href="#plan-finder" class="rounded-full bg-white/10 px-4 py-2 hover:bg-white/15">Plan finder</a>
      <a href="#promos" class="rounded-full bg-white/10 px-4 py-2 hover:bg-white/15">Promos</a>
    </div>
  </PageHero>

  <!-- PLANS -->
  <section id="plans" class="surface-dark rate-scope cut-top bg-charcoal pb-20 sm:pb-24" aria-labelledby="plans-title">
    <div class="container-az">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="eyebrow">Monthly plans</p>
          <h2 id="plans-title" class="h-section mt-3">Pick your plan</h2>
          <p class="lede mt-3 max-w-xl">Prices are per 4 weeks. Students get a lower rate on both plans.</p>
        </div>
        <RateToggle name="plans-rate" />
      </div>
      <div class="mt-10">
        <PlanCards headingLevel="h3" />
      </div>
    </div>
  </section>

  <!-- ACTIVATION + SESSIONS -->
  <section id="sessions" class="surface-light cut-top pb-20 sm:pb-24" aria-labelledby="sessions-title">
    <div class="container-az grid gap-8 lg:grid-cols-2">
      <div class="card-light p-6 sm:p-8">
        <p class="eyebrow">When you join</p>
        <h2 class="mt-3 text-4xl">{activationFee.name}</h2>
        <p class="price mt-4 text-6xl text-ink">{peso(activationFee.price)}</p>
        <p class="mt-1 text-sm text-slate">Paid once, the first time you sign up.</p>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {
            activationFee.includes.map((item) => (
              <li class="flex gap-2.5">
                <Icon name="circle-check" size={20} class="mt-0.5 shrink-0 text-leaf" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="card-light p-6 sm:p-8">
        <p class="eyebrow">No membership needed</p>
        <h2 id="sessions-title" class="mt-3 text-4xl">Gym sessions</h2>
        <p class="mt-2 text-slate">Try a workout or a class first. Pay per visit.</p>
        <table class="mt-5 w-full">
          <caption class="sr-only">Pay-per-visit prices</caption>
          <thead class="sr-only">
            <tr><th scope="col">Session</th><th scope="col">Price</th></tr>
          </thead>
          <tbody>
            {
              sessions.map((s) => (
                <tr class="border-b border-line last:border-0">
                  <th scope="row" class="py-3.5 text-left font-semibold">{s.name}</th>
                  <td class="py-3.5 text-right">
                    <span class="price text-3xl">{peso(s.price)}</span>
                    <span class="text-sm text-slate"> / {s.unit}</span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- CALCULATOR + PLAN FINDER -->
  <section class="surface-dark cut-top pb-20 sm:pb-24" aria-labelledby="calc-title">
    <div class="container-az grid gap-12 lg:grid-cols-2 lg:gap-10">
      <div id="calculator" class="scroll-mt-24">
        <p class="eyebrow">Membership calculator</p>
        <h2 id="calc-title" class="h-section mt-3">Estimate your first payment</h2>
        <p class="lede mt-3">Pick a plan and how many 4-week periods you want to pay for. We add the one-time activation fee for you.</p>
        <div class="mt-8">
          <MembershipCalculator
            client:visible
            plans={calcPlans}
            activationFee={activationFee.price}
            minPeriods={calculatorPeriods.min}
            maxPeriods={calculatorPeriods.max}
            messengerUrl={site.social.messenger}
            visitUrl="/book-a-visit/"
          />
        </div>
      </div>
      <div id="plan-finder" class="scroll-mt-24">
        <p class="eyebrow">Plan finder</p>
        <h2 class="h-section mt-3">Not sure which plan?</h2>
        <p class="lede mt-3">Answer 3 quick questions. Dali ra!</p>
        <div class="mt-8">
          <PlanFinder client:visible prices={finderPrices} />
        </div>
      </div>
    </div>
  </section>

  <!-- PROMOS + NOTES -->
  <section id="promos" class="surface-light cut-top pb-20 sm:pb-24" aria-labelledby="promos-title">
    <div class="container-az grid gap-10 lg:grid-cols-5">
      <div class="lg:col-span-3">
        <p class="eyebrow">For members</p>
        <h2 id="promos-title" class="h-section mt-3">Member promos</h2>
        <p class="lede mt-3">Members get access to these promos. Ask us about current promo details and we’ll walk you through what’s running now.</p>
        <ul class="mt-8 grid grid-cols-2 gap-3">
          {
            promos.map((p) => (
              <li class="card-light flex items-center gap-3 p-3 sm:gap-4 sm:p-4">
                <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-night text-neon">
                  <Icon name="tag" size={20} />
                </span>
                <span class="font-display text-xl font-bold uppercase leading-tight">{p}</span>
              </li>
            ))
          }
        </ul>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/book-a-visit/?interest=promo" class="btn btn-dark">Ask about promos <Icon name="arrow-right" size={18} /></a>
          <a href={site.social.messenger} target="_blank" rel="noopener" class="btn btn-outline-dark"><Icon name="messenger" size={18} /> Message us</a>
        </div>
      </div>

      <aside class="space-y-4 lg:col-span-2" aria-label="Payment and rate notes">
        <div class="card-light p-6">
          <h3 class="flex items-center gap-2 text-2xl"><Icon name="credit-card" size={22} class="text-leaf" /> Payments</h3>
          <p class="mt-2 text-slate">We accept credit and debit cards at the front desk.</p>
        </div>
        <div class="card-light p-6">
          <h3 class="flex items-center gap-2 text-2xl"><Icon name="info" size={22} class="text-leaf" /> About these rates</h3>
          <p class="mt-2 text-slate">{ratesDisclaimer}</p>
        </div>
        <div class="card-light p-6">
          <h3 class="flex items-center gap-2 text-2xl"><Icon name="graduation-cap" size={22} class="text-leaf" /> Students</h3>
          <p class="mt-2 text-slate">
            Basic is {peso(plans[0].price.student)} and Premium is {peso(plans[1].price.student)} per 4 weeks at the student rate.
            We’ll confirm the details with you when you sign up.
          </p>
        </div>
      </aside>
    </div>

    <div class="container-az mt-16">
      <h2 class="text-3xl">Rate questions</h2>
      <div class="mt-5 divide-y divide-line rounded-[var(--radius-card)] border border-line bg-white">
        {
          rateFaq.map((f) => (
            <details class="group p-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold [&::-webkit-details-marker]:hidden">
                {f.q}
                <Icon name="chevron-down" size={20} class="shrink-0 transition-transform group-open:rotate-180" />
              </summary>
              <p class="mt-3 text-slate">{f.a}</p>
            </details>
          ))
        }
      </div>
      <a href="/faq/" class="link mt-4 inline-block font-semibold">See all FAQs</a>
    </div>
  </section>

  <NewToGymCta />
</BaseLayout>
