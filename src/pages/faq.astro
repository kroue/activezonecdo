---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import NewToGymCta from '../components/NewToGymCta.astro';
import { site } from '../config/site';
import { faq } from '../data/faq';
import { faqSchema } from '../lib/schema';

const crumbs = [{ name: 'FAQ', path: '/faq/' }];
const categories = ['Rates', 'Getting started', 'Classes', 'Facilities'] as const;
---

<BaseLayout
  title="FAQ | Gym Rates, Student Rates & Beginners | ActiveZone CDO"
  description="Answers about ActiveZone CDO: membership and student rates, the activation fee, walk-ins, beginner coaching, personal training, showers, parking and card payments."
  ogImage="faq"
  breadcrumbs={crumbs}
  schema={[faqSchema(faq)]}
>
  <PageHero
    eyebrow="FAQ"
    title="Questions? We’ve got answers."
    lede="Rates, student plans, walk-ins, beginners and personal training in CDO. If your question isn’t here, message us."
    crumbs={crumbs}
  />

  <section class="surface-light cut-top pb-20 sm:pb-24">
    <div class="container-az grid gap-10 lg:grid-cols-12">
      <nav aria-label="FAQ topics" class="min-w-0 lg:col-span-3">
        <ul class="no-scrollbar -mx-4 flex gap-2 overflow-x-auto px-4 lg:sticky lg:top-28 lg:mx-0 lg:flex-col lg:px-0">
          {
            categories.map((c) => (
              <li class="shrink-0">
                <a
                  href={`#${c.toLowerCase().replace(/\s+/g, '-')}`}
                  class="block rounded-full border-2 border-line bg-white px-4 py-2 font-semibold hover:border-slate lg:rounded-xl"
                >
                  {c}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="space-y-10 lg:col-span-9">
        {
          categories.map((c) => (
            <div id={c.toLowerCase().replace(/\s+/g, '-')} class="scroll-mt-28">
              <h2 class="text-3xl sm:text-4xl">{c}</h2>
              <div class="mt-4 divide-y divide-line rounded-[var(--radius-card)] border border-line bg-white">
                {faq
                  .filter((f) => f.category === c)
                  .map((f) => (
                    <details class="group p-5 sm:p-6">
                      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold [&::-webkit-details-marker]:hidden">
                        {f.q}
                        <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-paper transition-transform group-open:rotate-180">
                          <Icon name="chevron-down" size={18} />
                        </span>
                      </summary>
                      <p class="mt-3 text-slate">{f.a}</p>
                    </details>
                  ))}
              </div>
            </div>
          ))
        }
        <div class="rounded-[var(--radius-card)] bg-night p-6 text-white sm:p-8">
          <h2 class="text-3xl">Still have a question?</h2>
          <p class="mt-2 text-mist">We’re happy to help. Message us or call the front desk.</p>
          <div class="mt-5 flex flex-col gap-3 sm:flex-row">
            <a href={site.social.messenger} target="_blank" rel="noopener" class="btn btn-neon"><Icon name="messenger" size={18} /> Message us</a>
            <a href={`tel:${site.phone.tel}`} class="btn btn-ghost"><Icon name="phone" size={18} /> {site.phone.display}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <NewToGymCta />
</BaseLayout>
