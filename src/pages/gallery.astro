---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import NewToGymCta from '../components/NewToGymCta.astro';
import { site } from '../config/site';
import { galleryPhotos, photoCategories } from '../data/photos';

const crumbs = [{ name: 'Gallery', path: '/gallery/' }];
// Full-size versions for the lightbox, generated by the same image service.
const items = await Promise.all(
  galleryPhotos.map(async (p) => {
    const full = await getImage({ src: p.src, width: 1600, height: Math.round((1600 * p.height) / p.width), quality: 70 });
    return { ...p, full: full.src };
  }),
);
---

<BaseLayout
  title="Gym Photos | Inside ActiveZone CDO, Divisoria, Cagayan de Oro"
  description="See inside ActiveZone CDO: the gym floor, group classes like Zumba and Boxing, and our community in Divisoria, Cagayan de Oro."
  ogImage="gallery"
  breadcrumbs={crumbs}
>
  <PageHero
    eyebrow="Gallery"
    title="Inside ActiveZone"
    lede="The gym floor, our classes and the people who make it feel like home."
    photo="gym-machines"
    crumbs={crumbs}
  />

  <section class="surface-light cut-top gallery-scope pb-20 sm:pb-24" aria-labelledby="gallery-heading">
    <div class="container-az">
      <h2 id="gallery-heading" class="sr-only">Photos</h2>
      <!-- Filter: pure CSS via :has(), no JavaScript needed. -->
      <fieldset>
        <legend class="sr-only">Filter photos</legend>
        <div class="segmented">
          <label><input type="radio" name="gallery-filter" value="all" checked /> All</label>
          {photoCategories.map((c) => <label><input type="radio" name="gallery-filter" value={c.id} /> {c.label}</label>)}
        </div>
      </fieldset>

      <ul class="mt-8 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-3" data-gallery>
        {
          items.map((p, i) => (
            <li data-cat={p.category} class:list={[i % 5 === 0 && 'col-span-2 lg:col-span-1 lg:row-span-2']}>
              <button
                type="button"
                class="group relative block h-full w-full overflow-hidden rounded-2xl text-left"
                data-full={p.full}
                data-alt={p.alt}
                data-caption={p.caption}
                aria-label={`View larger: ${p.alt}`}
              >
                <Photo
                  id={p.id}
                  class:list={['h-full transition-transform duration-500 group-hover:scale-[1.03]', i % 5 === 0 ? 'aspect-[16/10] lg:aspect-auto' : 'aspect-square']}
                  sizes={i % 5 === 0 ? '(min-width: 1024px) 33vw, 100vw' : '(min-width: 1024px) 33vw, 50vw'}
                  widths={[360, 480, 640, 768, 960]}
                  shade
                />
                <span class="absolute bottom-3 left-3 right-3 flex items-center justify-between gap-2 text-sm font-semibold text-white">
                  {p.caption}
                  <Icon name="zoom-in" size={18} class="text-neon" />
                </span>
              </button>
            </li>
          ))
        }
      </ul>

      <p class="mt-10 text-center text-slate">
        More photos and videos on
        <a href={site.social.facebook} target="_blank" rel="noopener" class="link font-semibold">Facebook</a>,
        <a href={site.social.instagram} target="_blank" rel="noopener" class="link font-semibold">Instagram</a> and
        <a href={site.social.tiktok} target="_blank" rel="noopener" class="link font-semibold">TikTok</a>.
      </p>
    </div>
  </section>

  <dialog
    id="lightbox"
    class="m-auto w-[min(64rem,calc(100vw-2rem))] max-w-none overflow-visible bg-transparent p-0 text-white backdrop:bg-night/90 backdrop:backdrop-blur-sm"
    aria-label="Photo viewer"
  >
    <figure class="relative">
      <img data-lb-img alt="" class="max-h-[78dvh] w-full rounded-2xl bg-charcoal object-contain" width="1600" height="1067" />
      <figcaption data-lb-cap class="mt-3 text-center font-semibold"></figcaption>
    </figure>
    <div class="mt-4 flex items-center justify-center gap-3">
      <button type="button" data-lb-prev class="flex size-12 items-center justify-center rounded-full bg-white/10 hover:bg-white/20" aria-label="Previous photo">
        <Icon name="chevron-left" size={22} />
      </button>
      <button type="button" data-lb-close class="btn btn-neon !min-h-12">Close</button>
      <button type="button" data-lb-next class="flex size-12 items-center justify-center rounded-full bg-white/10 hover:bg-white/20" aria-label="Next photo">
        <Icon name="chevron-right" size={22} />
      </button>
    </div>
  </dialog>

  <NewToGymCta />
</BaseLayout>

<style>
  .gallery-scope:has(input[value='gym']:checked) [data-cat]:not([data-cat='gym']),
  .gallery-scope:has(input[value='classes']:checked) [data-cat]:not([data-cat='classes']),
  .gallery-scope:has(input[value='community']:checked) [data-cat]:not([data-cat='community']) {
    display: none;
  }
  /* When filtered, keep a tidy uniform grid. */
  .gallery-scope:has(input:not([value='all']):checked) [data-cat] {
    grid-column: auto;
    grid-row: auto;
  }
  .gallery-scope:has(input:not([value='all']):checked) [data-cat] :global(.photo-tile) {
    aspect-ratio: 1;
  }
</style>

<script>
  // Lightbox on the native <dialog>: focus trapping, Escape to close and backdrop are built in.
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  const img = dialog?.querySelector<HTMLImageElement>('[data-lb-img]');
  const cap = dialog?.querySelector<HTMLElement>('[data-lb-cap]');
  let current = 0;
  let opener: HTMLElement | null = null;

  const visibleButtons = () =>
    [...document.querySelectorAll<HTMLButtonElement>('[data-gallery] button[data-full]')].filter(
      (b) => b.offsetParent !== null,
    );

  const show = (i: number) => {
    const list = visibleButtons();
    if (!list.length || !img || !cap) return;
    current = (i + list.length) % list.length;
    const b = list[current];
    img.src = b.dataset.full!;
    img.alt = b.dataset.alt!;
    cap.textContent = `${b.dataset.caption} · ${current + 1} of ${list.length}`;
  };

  document.querySelector('[data-gallery]')?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-full]');
    if (!btn || !dialog) return;
    opener = btn;
    show(visibleButtons().indexOf(btn));
    dialog.showModal();
  });
  dialog?.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(current - 1));
  dialog?.querySelector('[data-lb-next]')?.addEventListener('click', () => show(current + 1));
  dialog?.querySelector('[data-lb-close]')?.addEventListener('click', () => dialog.close());
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
  dialog?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });
  dialog?.addEventListener('close', () => opener?.focus());
</script>
