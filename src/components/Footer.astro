---
import { fullAddress, nav, site } from '../config/site';
import Logo from './Logo.astro';
import Icon from './Icon.astro';

const socials = [
  { href: site.social.facebook, label: 'Facebook', icon: 'facebook' },
  { href: site.social.instagram, label: 'Instagram', icon: 'instagram' },
  { href: site.social.tiktok, label: 'TikTok', icon: 'tiktok' },
  { href: site.social.messenger, label: 'Messenger', icon: 'messenger' },
];
const year = new Date().getFullYear();
---

<footer class="surface-dark border-t border-white/10 pb-24 pt-14 md:pb-10">
  <div class="container-az grid gap-10 md:grid-cols-12">
    <div class="md:col-span-4">
      <a href="/" aria-label={`${site.shortName} home`} class="inline-block rounded-lg"><Logo /></a>
      <p class="mt-4 max-w-xs text-sm text-mist">{site.tagline}.</p>
      <ul class="mt-5 flex gap-2" aria-label="Social media">
        {
          socials.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener"
                class="flex size-11 items-center justify-center rounded-full bg-white/5 ring-1 ring-white/10 transition-colors hover:bg-neon hover:text-night"
                aria-label={`ActiveZone CDO on ${s.label}`}
              >
                <Icon name={s.icon} size={18} />
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="mt-6 flex flex-wrap gap-2 text-xs font-semibold" aria-label="Community">
        <li class="inline-flex items-center gap-1.5 rounded-full bg-white/5 px-3 py-1.5 ring-1 ring-white/10">
          <Icon name="rainbow" size={14} class="text-neon" /> LGBTQ+ friendly
        </li>
        <li class="inline-flex items-center gap-1.5 rounded-full bg-white/5 px-3 py-1.5 ring-1 ring-white/10">
          <Icon name="shield-check" size={14} class="text-neon" /> Transgender safe space
        </li>
      </ul>
    </div>

    <div class="md:col-span-3">
      <h2 class="font-display text-lg font-bold uppercase tracking-wider text-neon">Visit us</h2>
      <address class="mt-3 text-sm not-italic leading-relaxed text-white/85">{fullAddress}</address>
      <a href={site.directionsUrl} target="_blank" rel="noopener" class="link mt-2 inline-block text-sm font-semibold">Get directions</a>
      <p class="mt-4 text-sm">
        <a href={`tel:${site.phone.tel}`} class="inline-flex items-center gap-2 font-semibold hover:text-neon">
          <Icon name="phone" size={16} class="text-neon" />
          {site.phone.display}
        </a>
      </p>
    </div>

    <div class="md:col-span-2">
      <h2 class="font-display text-lg font-bold uppercase tracking-wider text-neon">Hours</h2>
      <dl class="mt-3 space-y-2 text-sm">
        {
          site.hoursSummary.map((h) => (
            <div>
              <dt class="text-mist">{h.label}</dt>
              <dd class="font-semibold">{h.time}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <nav class="md:col-span-3" aria-label="Footer">
      <h2 class="font-display text-lg font-bold uppercase tracking-wider text-neon">Explore</h2>
      <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
        {
          [...nav, { href: '/book-a-visit/', label: 'Book a Visit' }, { href: '/privacy/', label: 'Privacy Policy' }].map((item) => (
            <li>
              <a href={item.href} class="inline-block py-1.5 text-white/85 hover:text-neon">
                {item.label === 'Rates' ? 'Memberships & Rates' : item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="container-az mt-12 flex flex-col gap-2 border-t border-white/10 pt-6 text-xs text-mist sm:flex-row sm:items-center sm:justify-between">
    <p>© {year} {site.name}. All rights reserved.</p>
    <p>Accepts credit and debit cards · Showers · Free parking</p>
  </div>
</footer>
