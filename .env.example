# Resend API key (https://resend.com/api-keys). Leave empty to run the form in demo mode.
RESEND_API_KEY=
# Where "Book a Visit" inquiries are delivered. Never shown on the site.
INQUIRY_TO_EMAIL=
# Optional. A sender on a domain verified in Resend, e.g. "ActiveZone Website <website@activezonecdo.com>".
# Defaults to Resend's onboarding sender, which only delivers to your own Resend account email.
INQUIRY_FROM_EMAIL=
# Optional. The live domain for canonical URLs and the sitemap, e.g. https://activezonecdo.com
SITE_URL=
